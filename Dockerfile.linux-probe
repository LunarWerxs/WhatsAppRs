# Linux leg of the capability probe: does web.whatsapp.com work in WebKitGTK,
# the engine wry uses on Linux? Nothing proven on Windows/WebView2 carries over,
# because WebKitGTK is not Chromium.
#
# Runs headless under Xvfb. Prints the probe report to stdout.
FROM rust:1-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
      libwebkit2gtk-4.1-dev \
      libgtk-3-dev \
      libayatana-appindicator3-dev \
      librsvg2-dev \
      libsoup-3.0-dev \
      pkg-config \
      xvfb \
      xauth \
      dbus-x11 \
      ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Compile dependencies against a stub main first, so editing src/ only recompiles
# our own crate on later runs instead of all of gtk/webkit2gtk/tao/wry.
COPY Cargo.toml ./
RUN mkdir -p src && echo 'fn main() {}' > src/main.rs && cargo build --release && rm -rf src

COPY src ./src
# Cargo skips a rebuild if mtime looks unchanged after the stub; force it.
RUN touch src/main.rs && cargo build --release

# Report the engine version actually present, so the result is attributable.
RUN pkg-config --modversion webkit2gtk-4.1 > /webkit-version.txt || echo "unknown" > /webkit-version.txt

# A notification daemon is absent in a container, which is itself worth observing:
# it is exactly the state of a minimal Linux desktop.
CMD set -e; \
    echo "=== WebKitGTK version ==="; cat /webkit-version.txt; \
    echo "=== running probe under Xvfb ==="; \
    rm -f /app/probe-report.jsonl; \
    ( dbus-run-session -- xvfb-run -a -s "-screen 0 1280x900x24" \
        /app/target/release/whatsapp-probe > /app/probe-stdout.log 2>&1 & ) ; \
    sleep 40; \
    echo "=== stdout ==="; cat /app/probe-stdout.log || true; \
    echo "=== probe-report.jsonl ==="; cat /app/probe-report.jsonl || echo "NO REPORT WRITTEN"
