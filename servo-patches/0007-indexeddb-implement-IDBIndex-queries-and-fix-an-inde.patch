+/// What an index query should hand back once its records have been gathered.
+#[derive(Clone, Copy, MallocSizeOf, PartialEq)]
+pub(crate) enum IndexQueryKind {
+    /// The referenced value of the first matching record.
+    Get,
+    /// The primary key of the first matching record.
+    GetKey,
+    /// Every matching referenced value.
+    GetAll,
+    /// Every matching primary key.
+    GetAllKeys,
+    /// How many records match.
+    Count,
+    /// Feed the records to a cursor instead of answering directly.
+    Cursor,
+}
+
+/// Everything the reply handler needs to turn a full store scan into the answer
+/// to one index query.
+#[derive(Clone, JSTraceable, MallocSizeOf)]
+pub(crate) struct IndexQueryParam {
+    pub(crate) index: Trusted<IDBIndex>,
+    #[no_trace]
+    pub(crate) range: IndexedDBKeyRange,
+    pub(crate) count: Option<u32>,
+    #[no_trace]
+    pub(crate) kind: IndexQueryKind,
+}
+
+impl IndexQueryParam {
+    /// Build the JavaScript answer for a non-cursor index query from the records
+    /// that matched, honouring the query's `count` limit.
+    pub(crate) fn answer(
+        &self,
+        cx: &mut JSContext,
+        global: &GlobalScope,
+        records: &[IndexedDBRecord],
+        mut answer: MutableHandleValue,
+    ) -> Result<(), Error> {
+        let limit = match self.count {
+            Some(0) | None => records.len(),
+            Some(count) => (count as usize).min(records.len()),
+        };
+
+        match self.kind {
+            IndexQueryKind::Get => match records.first() {
+                Some(record) => read_value(cx, global, record, answer)?,
+                // A query that matches nothing resolves with undefined, not an error.
+                None => answer.set(UndefinedValue()),
+            },
+            IndexQueryKind::GetKey => match records.first() {
+                Some(record) => key_type_to_jsval(cx, &record.primary_key, answer),
+                None => answer.set(UndefinedValue()),
+            },
+            IndexQueryKind::GetAll => {
+                rooted!(&in(cx) let mut values = vec![JSVal::default(); limit]);
+                for (i, record) in records.iter().take(limit).enumerate() {
+                    read_value(cx, global, record, values.handle_mut_at(i))?;
+                }
+                values.to_jsval(cx, answer);
+            },
+            IndexQueryKind::GetAllKeys => {
+                rooted!(&in(cx) let mut keys = vec![JSVal::default(); limit]);
+                for (i, record) in records.iter().take(limit).enumerate() {
+                    key_type_to_jsval(cx, &record.primary_key, keys.handle_mut_at(i));
+                }
+                keys.to_jsval(cx, answer);
+            },
+            IndexQueryKind::Count => answer.set(DoubleValue(records.len() as f64)),
+            IndexQueryKind::Cursor => unreachable!("a cursor query never answers directly"),
+        }
+        Ok(())
+    }
+}
+
+/// Deserialize a record's stored value into a JavaScript value.
+fn read_value(
+    cx: &mut JSContext,
+    global: &GlobalScope,
+    record: &IndexedDBRecord,
+    answer: MutableHandleValue,
+) -> Result<(), Error> {
+    let data = postcard::from_bytes(&record.value).map_err(|_| Error::Data(None))?;
+    structuredclone::read(cx, global, data, answer).map(|_ports| ())
+}
+
+impl IDBIndex {
+    fn transaction(&self) -> DomRoot<IDBTransaction> {
+        self.object_store.transaction()
+    }
+
+    /// The checks every index query shares.
+    fn check_usable(&self) -> ErrorResult {
+        self.object_store.verify_not_deleted()?;
+        let transaction = self.transaction();
+        if !transaction.is_active() || !transaction.is_usable() {
+            return Err(Error::TransactionInactive(None));
+        }
+        Ok(())
+    }
+
+    /// Run an index query.
+    ///
+    /// Servo's IndexedDB backend keeps no index entries: its `index_data` table is
+    /// created and cleared but never written, so there is nothing to look up. Until
+    /// the backend maintains real indexes, the records are derived here instead, by
+    /// reading the object store and evaluating this index's key path over the
+    /// values. That is correct but linear in the size of the store, so it is a
+    /// stepping stone rather than the destination.
+    fn query(
+        &self,
+        cx: &mut JSContext,
+        query: HandleValue,
+        kind: IndexQueryKind,
+        count: Option<u32>,
+        iteration_param: Option<IterationParam>,
+    ) -> Fallible<DomRoot<IDBRequest>> {
+        self.check_usable()?;
+
+        // The range applies to this index's keys, not to the store's.
+        let range = convert_value_to_key_range(cx, query, Some(false))?;
+
+        let index_param = IndexQueryParam {
+            index: Trusted::new(self),
+            range,
+            count,
+            kind,
+        };
+
+        // Scan the whole store; the reply handler narrows it down.
+        IDBRequest::execute_async_indexed(
+            cx,
+            &self.object_store,
+            |callback| {
+                AsyncOperation::ReadOnly(AsyncReadOnlyOperation::Iterate {
+                    callback,
+                    key_range: IndexedDBKeyRange::default(),
+                })
+            },
+            None,
+            iteration_param,
+            Some(index_param),
+        )
+    }
+
+    fn open_cursor(
+        &self,
+        cx: &mut JSContext,
+        query: HandleValue,
+        direction: IDBCursorDirection,
+        key_only: bool,
+    ) -> Fallible<DomRoot<IDBRequest>> {
+        self.check_usable()?;
+        let range = convert_value_to_key_range(cx, query, Some(false))?;
+
+        let cursor = if key_only {
+            IDBCursor::new(
+                cx,
+                &self.global(),
+                &self.transaction(),
+                direction,
+                false,
+                ObjectStoreOrIndex::Index(Dom::from_ref(self)),
+                range.clone(),
+                key_only,
+            )
+        } else {
+            DomRoot::upcast(IDBCursorWithValue::new(
+                cx,
+                &self.global(),
+                &self.transaction(),
+                direction,
+                false,
+                ObjectStoreOrIndex::Index(Dom::from_ref(self)),
+                range.clone(),
+                key_only,
+            ))
+        };
+
+        let iteration_param = IterationParam {
+            cursor: Trusted::new(&cursor),
+            key: None,
+            primary_key: None,
+            count: None,
+        };
+
+        self.query(cx, query, IndexQueryKind::Cursor, None, Some(iteration_param))
+            .inspect(|request| cursor.set_request(request))
+    }
+
+    /// Turn the store's records into this index's records: evaluate the key path
+    /// over each value, drop the ones it does not apply to, expand `multiEntry`
+    /// arrays, and sort into index order.
+    ///
+    /// <https://w3c.github.io/IndexedDB/#index-referenced-value>
+    pub(crate) fn records_for(
+        &self,
+        cx: &mut JSContext,
+        global: &GlobalScope,
+        store_records: Vec<IndexedDBRecord>,
+    ) -> Vec<IndexedDBRecord> {
+        let mut out: Vec<IndexedDBRecord> = Vec::new();
+
+        for record in store_records {
+            rooted!(&in(cx) let mut value = UndefinedValue());
+            let read = postcard::from_bytes(&record.value)
+                .map_err(|_| ())
+                .and_then(|data| {
+                    structuredclone::read(cx, global, data, value.handle_mut()).map_err(|_| ())
+                });
+            if read.is_err() {
+                continue;
+            }
+
+            rooted!(&in(cx) let mut key_value = UndefinedValue());
+            let evaluated = evaluate_key_path_on_value(
+                cx,
+                value.handle(),
+                &self.key_path,
+                key_value.handle_mut(),
+            );
+            let Ok(EvaluationResult::Success) = evaluated else {
+                // A record whose value has no key for this index is simply not in it.
+                continue;
+            };
+
+            // multiEntry turns an array key into one index record per element.
+            let keys = if self.multi_entry {
+                match extract_multi_entry_keys(cx, key_value.handle()) {
+                    Some(keys) => keys,
+                    None => continue,
+                }
+            } else {
+                match convert_value_to_key(cx, key_value.handle(), None) {
+                    Ok(ConversionResult::Valid(key)) => vec![key],
+                    _ => continue,
+                }
+            };
+
+            for key in keys {
+                out.push(IndexedDBRecord {
+                    key,
+                    primary_key: record.primary_key.clone(),
+                    value: record.value.clone(),
+                });
+            }
+        }
+
+        // Index order is by index key, then by primary key.
+        out.sort_by(|a, b| {
+            a.key
+                .partial_cmp(&b.key)
+                .unwrap_or(Ordering::Equal)
+                .then_with(|| {
+                    a.primary_key
+                        .partial_cmp(&b.primary_key)
+                        .unwrap_or(Ordering::Equal)
+                })
+        });
+
+        // A unique index keeps only the first record for each key.
+        if self.unique {
+            out.dedup_by(|a, b| a.key == b.key);
+        }
+        out
+    }
+}
+
+/// The elements of an array key, for a `multiEntry` index. Non-array keys stay
+/// single, and invalid entries are dropped rather than failing the record.
+fn extract_multi_entry_keys(
+    cx: &mut JSContext,
+    value: HandleValue,
+) -> Option<Vec<IndexedDBKeyType>> {
+    if let Ok(ConversionResult::Valid(IndexedDBKeyType::Array(entries))) =
+        convert_value_to_key(cx, value, None)
+    {
+        let mut keys: Vec<IndexedDBKeyType> = Vec::new();
+        for entry in entries {
+            if !keys.contains(&entry) {
+                keys.push(entry);
+            }
+        }
+        return Some(keys);
+    }
+    match convert_value_to_key(cx, value, None) {
+        Ok(ConversionResult::Valid(key)) => Some(vec![key]),
+        _ => None,
+    }
+}
