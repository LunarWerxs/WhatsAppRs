+/// Which method a pending backend reply belongs to, so `handle_response` resolves the
+/// promise in the shape that method promised. Replies arrive in the order requests were
+/// sent, because the storage thread handles messages sequentially.
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum PendingOp {
+    Keys,
+    /// `match`: resolve with the first response, or undefined.
+    MatchFirst,
+    /// `matchAll`: resolve with every response.
+    MatchAll,
+    Put,
+    Delete,
+}
 
