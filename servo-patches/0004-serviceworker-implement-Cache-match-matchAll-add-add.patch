+#[cfg(test)]
+mod tests {
+    use storage_traits::cache_storage::CacheResponseType;
+
+    use super::*;
+
+    fn request(url: &str, method: &str, headers: &[(&str, &str)]) -> CacheRequestRecord {
+        CacheRequestRecord {
+            url: url.to_string(),
+            method: method.to_string(),
+            headers: headers
+                .iter()
+                .map(|(n, v)| (n.to_string(), v.to_string()))
+                .collect(),
+        }
+    }
+
+    fn response(headers: &[(&str, &str)]) -> CacheResponseRecord {
+        CacheResponseRecord {
+            url: "https://example.com/".to_string(),
+            status: 200,
+            status_text: b"OK".to_vec(),
+            headers: headers
+                .iter()
+                .map(|(n, v)| (n.to_string(), v.to_string()))
+                .collect(),
+            body: b"body".to_vec(),
+            response_type: CacheResponseType::Basic,
+        }
+    }
+
+    fn opts(
+        ignore_search: bool,
+        ignore_method: bool,
+        ignore_vary: bool,
+    ) -> CacheQueryOptionsRecord {
+        CacheQueryOptionsRecord {
+            ignore_search,
+            ignore_method,
+            ignore_vary,
+        }
+    }
+
+    #[test]
+    fn url_comparison_strips_fragment_and_optionally_query() {
+        assert_eq!(
+            url_for_comparison("https://a/b?x=1#frag", false),
+            "https://a/b?x=1"
+        );
+        assert_eq!(
+            url_for_comparison("https://a/b?x=1#frag", true),
+            "https://a/b"
+        );
+        assert_eq!(url_for_comparison("https://a/b", true), "https://a/b");
+    }
+
+    #[test]
+    fn matches_same_url_and_differs_on_query_unless_ignored() {
+        let cached = request("https://a/b?x=1", "GET", &[]);
+        let same = request("https://a/b?x=1#other", "GET", &[]);
+        let other_query = request("https://a/b?x=2", "GET", &[]);
+        assert!(request_matches_cached_item(
+            &same,
+            &cached,
+            None,
+            opts(false, false, false)
+        ));
+        assert!(!request_matches_cached_item(
+            &other_query,
+            &cached,
+            None,
+            opts(false, false, false)
+        ));
+        assert!(request_matches_cached_item(
+            &other_query,
+            &cached,
+            None,
+            opts(true, false, false)
+        ));
+    }
+
+    #[test]
+    fn non_get_cached_request_never_matches_unless_method_ignored() {
+        let cached = request("https://a/b", "POST", &[]);
+        let query = request("https://a/b", "GET", &[]);
+        assert!(!request_matches_cached_item(
+            &query,
+            &cached,
+            None,
+            opts(false, false, false)
+        ));
+        assert!(request_matches_cached_item(
+            &query,
+            &cached,
+            None,
+            opts(false, true, false)
+        ));
+    }
+
+    #[test]
+    fn vary_header_is_honoured() {
+        let cached = request("https://a/b", "GET", &[("accept", "text/html")]);
+        let resp = response(&[("vary", "Accept")]);
