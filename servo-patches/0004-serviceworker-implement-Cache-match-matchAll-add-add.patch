+    /// Steps 1-7 of <https://w3c.github.io/ServiceWorker/#cache-put>: validate, then read the
+    /// whole body and hand the pair to the backend. The promise settles from `handle_response`.
+    fn put_request_response(
+        &self,
+        cx: &mut JSContext,
+        promise: &Rc<Promise>,
+        request: &Request,
+        response: &Response,
+    ) {
+        let global = self.global();
+        let request_record = request_record(cx, request);
+
+        // Step 2: If innerRequest’s url’s scheme is not one of "http" and "https", then
+        // return a promise rejected with a TypeError.
+        if !is_http_scheme(&request_record.url) {
+            promise.reject_error(
+                cx,
+                Error::Type(c"Request scheme must be http or https".to_owned()),
+            );
+            return;
+        }
+
+        // Step 3: If innerRequest’s method is not `GET`, return a promise rejected with a TypeError.
+        if !request_record.method.eq_ignore_ascii_case("GET") {
+            promise.reject_error(cx, Error::Type(c"Request method must be GET".to_owned()));
+            return;
+        }
+
+        // Step 4: Let innerResponse be response’s response.
+        let status = response.Status();
+        let response_headers = header_pairs(&response.Headers(cx).get_headers_list());
+
+        // Step 5: If innerResponse’s status is 206, return a promise rejected with a TypeError.
+        if status == 206 {
+            promise.reject_error(
+                cx,
+                Error::Type(c"Partial responses cannot be cached".to_owned()),
+            );
+            return;
+        }
+
+        // Step 6: If innerResponse’s header list contains `Vary`, then:
+        // Step 6.1: Let fieldValues be the list containing the elements corresponding to the
+        // field-values of the Vary header for the value of the header with name `Vary`.
+        // Step 6.2: For each fieldValue of fieldValues: if fieldValue matches "*", return a
+        // promise rejected with a TypeError.
+        for (name, value) in &response_headers {
+            if name.eq_ignore_ascii_case("vary") &&
+                value.split(',').any(|field| field.trim() == "*")
+            {
+                promise.reject_error(
+                    cx,
+                    Error::Type(c"Responses with Vary: * cannot be cached".to_owned()),
+                );
+                return;
+            }
+        }
+
+        // Step 7: If innerResponse’s body is disturbed or locked, return a promise rejected
+        // with a TypeError.
+        if response.is_unusable() {
+            promise.reject_error(
+                cx,
+                Error::Type(c"Response body is disturbed or locked".to_owned()),
+            );
+            return;
         }
+
+        let response_type = match response.Type() {
+            DOMResponseType::Basic => CacheResponseType::Basic,
+            DOMResponseType::Cors => CacheResponseType::Cors,
+            DOMResponseType::Default => CacheResponseType::Default,
+            DOMResponseType::Error => CacheResponseType::Error,
+            DOMResponseType::Opaque => CacheResponseType::Opaque,
+            DOMResponseType::Opaqueredirect => CacheResponseType::OpaqueRedirect,
+        };
+        let response_record = CacheResponseRecord {
+            url: response.Url().0,
+            status,
+            status_text: Vec::from(response.StatusText()),
+            headers: response_headers,
+            body: Vec::new(),
+            response_type,
+        };
+
+        // Step 8: Let clonedResponse be the result of cloning innerResponse.
+        // Step 9: Let bodyReadPromise be a promise resolved with undefined.
+        // Step 10: If innerResponse’s body is non-null, then:
+        // Step 10.1: Let stream be innerResponse’s body’s stream.
+        // Step 10.2: Let reader be the result of getting a reader for stream.
+        // Step 10.3: Set bodyReadPromise to the result of reading all bytes from stream with reader.
+        // Note: the body is consumed here rather than cloned; this object is the only reader.
+        let Some(stream) = response.body() else {
+            let cache_name = self.name.to_string();
+            self.send_or_reject(
+                cx,
+                promise,
+                PendingOp::Put,
+                CacheStorageThreadMessage::Put {
+                    cache_name,
+                    callback: self.get_or_setup_callback(),
+                    origin: global.origin().immutable().clone(),
+                    request: request_record,
+                    response: response_record,
+                },
+            );
+            return;
+        };
+        let reader = match stream.acquire_default_reader(cx) {
+            Ok(reader) => reader,
+            Err(error) => {
+                promise.reject_error(cx, error);
+                return;
+            },
+        };
+
+        // Step 11: Let responseBodyPromise be a promise resolved with undefined. ...
+        // Step 12: Return the result of reacting to bodyReadPromise: run the batch cache
+        // operation with the fully read body.
+        let this = Trusted::new(self);
+        let success_promise = promise.clone();
+        let failure_promise = promise.clone();
+        reader.read_all_bytes(
+            cx,
+            Rc::new(move |cx, bytes| {
+                let cache = this.root();
+                let mut response_record = response_record.clone();
+                response_record.body = bytes.to_vec();
+                let cache_name = cache.name.to_string();
+                let origin = cache.global().origin().immutable().clone();
+                cache.send_or_reject(
+                    cx,
+                    &success_promise,
+                    PendingOp::Put,
+                    CacheStorageThreadMessage::Put {
+                        cache_name,
+                        callback: cache.get_or_setup_callback(),
+                        origin,
+                        request: request_record.clone(),
+                        response: response_record,
+                    },
+                );
+            }),
+            Rc::new(move |cx, value| {
+                failure_promise.reject(cx, value);
+            }),
+        );
+    }
+}
