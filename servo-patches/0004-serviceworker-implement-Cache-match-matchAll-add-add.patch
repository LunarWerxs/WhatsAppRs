+/// The fulfillment side of one fetch inside `addAll`: put the fetched response, then
+/// settle the shared promise once every request has been put.
+#[derive(JSTraceable, MallocSizeOf)]
+struct AddAllFetchHandler {
+    #[ignore_malloc_size_of = "Trusted"]
+    cache: Trusted<Cache>,
+    #[no_trace]
+    #[ignore_malloc_size_of = "plain data"]
+    request: CacheRequestRecord,
+    #[conditional_malloc_size_of]
+    promise: Rc<Promise>,
+    #[ignore_malloc_size_of = "Rc<Cell>"]
+    remaining: Rc<Cell<usize>>,
+    #[ignore_malloc_size_of = "Rc<Cell>"]
+    failed: Rc<Cell<bool>>,
+}
+
+impl Callback for AddAllFetchHandler {
+    fn callback(&self, realm: &mut CurrentRealm, value: HandleValue) {
+        if self.failed.get() {
+            return;
+        }
+        let cx: &mut JSContext = realm;
+        let Ok(response) = root_from_handlevalue::<Response>(cx, value) else {
+            self.failed.set(true);
+            self.promise.reject_error(
+                cx,
+                Error::Type(c"fetch did not produce a Response".to_owned()),
+            );
+            return;
+        };
+        // <https://w3c.github.io/ServiceWorker/#cache-addall> step 5.3.3:
+        // If response’s type is "error", or response’s status is not an ok status,
+        // reject with a TypeError.
+        if response.Type() == DOMResponseType::Error || !response.Ok() {
+            self.failed.set(true);
+            self.promise.reject_error(
+                cx,
+                Error::Type(c"addAll fetched a non-ok response".to_owned()),
+            );
+            return;
+        }
+        let cache = self.cache.root();
+        let global = cache.global();
+        let Ok(url) = ServoUrl::parse(&self.request.url) else {
+            self.failed.set(true);
+            self.promise
+                .reject_error(cx, Error::Type(c"Invalid URL".to_owned()));
+            return;
+        };
+        let request = Request::new(cx, &global, None, url);
