+/// Convert a header map into the (lowercase name, value) pairs the storage side stores.
+fn header_pairs(headers: &HyperHeaders) -> Vec<(String, String)> {
+    headers
+        .iter()
+        .map(|(name, value)| {
+            (
+                name.as_str().to_string(),
+                String::from_utf8_lossy(value.as_bytes()).into_owned(),
+            )
+        })
+        .collect()
+}
+
+/// Build a header map back out of stored pairs, skipping any pair that is no longer a
+/// valid header (which cannot happen for pairs that came from a real header map).
+fn header_map(pairs: &[(String, String)]) -> HyperHeaders {
+    let mut headers = HyperHeaders::new();
+    for (name, value) in pairs {
+        if let (Ok(name), Ok(value)) = (
+            HeaderName::from_bytes(name.as_bytes()),
+            HeaderValue::from_bytes(value.as_bytes()),
+        ) {
+            headers.append(name, value);
+        }
+    }
+    headers
+}
+
+/// The reduced form of a `Request` that the Cache Storage algorithms read.
+fn request_record(cx: &mut JSContext, request: &Request) -> CacheRequestRecord {
+    CacheRequestRecord {
+        url: request.Url().0,
+        method: String::from_utf8_lossy(&Vec::from(request.Method())).into_owned(),
+        headers: header_pairs(&request.Headers(cx).get_headers_list()),
+    }
+}
+
+fn query_options(options: &CacheQueryOptions) -> CacheQueryOptionsRecord {
+    CacheQueryOptionsRecord {
+        ignore_search: options.ignoreSearch,
+        ignore_method: options.ignoreMethod,
+        ignore_vary: options.ignoreVary,
+    }
+}
+
+/// The request half of the Cache algorithms' preamble:
+/// "If request is a Request object, set r to request's request. Else, set r to the
+/// associated request of the result of invoking the initial value of Request as
+/// constructor with request as its argument. If this throws, reject with it."
+fn request_from_info(
+    cx: &mut JSContext,
+    global: &GlobalScope,
+    request: RequestOrUSVString,
+) -> Result<DomRoot<Request>, Error> {
+    match request {
+        RequestOrUSVString::Request(request) => Ok(request),
+        RequestOrUSVString::USVString(request_string) => {
+            let base = global.api_base_url();
+            let Ok(url) = base.join(&request_string.0) else {
+                // Note: only the url parse can error.
+                return Err(Error::Type(c"Invalid URL".to_owned()));
+            };
+            Ok(Request::new(cx, global, None, url))
+        },
+    }
+}
+
+fn is_http_scheme(url: &str) -> bool {
+    ServoUrl::parse(url)
+        .map(|url| matches!(url.scheme(), "http" | "https"))
+        .unwrap_or(false)
+}
+
+/// Rebuild a `Response` object from a stored record, with an immutable headers guard, as
+/// <https://w3c.github.io/ServiceWorker/#cache-match> step 5.4.2 and friends require.
+pub(crate) fn response_from_record(
+    cx: &mut JSContext,
+    global: &GlobalScope,
+    record: &CacheResponseRecord,
+) -> DomRoot<Response> {
+    let response = Response::new(cx, global);
+    let response_type = match record.response_type {
+        CacheResponseType::Basic => DOMResponseType::Basic,
+        CacheResponseType::Cors => DOMResponseType::Cors,
+        CacheResponseType::Default => DOMResponseType::Default,
+        CacheResponseType::Error => DOMResponseType::Error,
+        CacheResponseType::Opaque => DOMResponseType::Opaque,
+        CacheResponseType::OpaqueRedirect => DOMResponseType::Opaqueredirect,
+    };
+    // Setting the type first lets the opaque and error cases clear status, headers
+    // and body the way the fetch spec's filtered responses are shaped.
+    response.set_type(cx, response_type);
+    let has_visible_body = !matches!(
+        response_type,
+        DOMResponseType::Error | DOMResponseType::Opaque | DOMResponseType::Opaqueredirect
+    );
+    if has_visible_body {
+        response.set_status(&HttpStatus::new_raw(
+            record.status,
+            record.status_text.clone(),
+        ));
+        response.set_headers(cx, Some(Serde(header_map(&record.headers))));
+        if let Ok(url) = ServoUrl::parse(&record.url) {
+            response.set_final_url(url);
+        }
+        response.stream_chunk(cx, Bytes::from(record.body.clone()));
+        response.finish(cx);
+    }
+    response.Headers(cx).set_guard(Guard::Immutable);
+    response
 }
 
