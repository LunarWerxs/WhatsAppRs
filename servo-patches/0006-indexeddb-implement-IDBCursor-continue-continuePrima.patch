+    /// A cursor reuses one IDBRequest for every step of its iteration, so the
+    /// request goes back to pending each time it is sent out again.
+    pub(crate) fn set_ready_state_pending(&self) {
+        self.ready_state.set(IDBRequestReadyState::Pending);
+    }
+
     pub fn set_ready_state_done(&self) {
         self.ready_state.set(IDBRequestReadyState::Done);
     }
