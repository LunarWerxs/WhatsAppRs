+
+    /// <https://w3c.github.io/IndexedDB/#cursor-effective-object-store>
+    ///
+    /// The store the records actually come from, whether the cursor was opened on
+    /// a store or on one of its indexes.
+    fn effective_object_store(&self) -> DomRoot<IDBObjectStore> {
+        match &self.source {
+            ObjectStoreOrIndex::ObjectStore(store) => DomRoot::from_ref(store),
+            ObjectStoreOrIndex::Index(index) => index.ObjectStore(),
+        }
+    }
+
+    /// The shared tail of `continue()`, `continuePrimaryKey()` and `advance()`:
+    /// everything from "set the cursor's got value flag to false" onwards.
+    ///
+    /// <https://w3c.github.io/IndexedDB/#dom-idbcursor-continue> step 6 onwards.
+    fn run_iteration(
+        &self,
+        cx: &mut JSContext,
+        key: Option<IndexedDBKeyType>,
+        primary_key: Option<IndexedDBKeyType>,
+        count: Option<u32>,
+    ) -> Fallible<()> {
+        // Step: Set this cursor's got value flag to false.
+        self.got_value.set(false);
+
+        // Step: Let request be this cursor's request. Set request's processed flag
+        // to false and its done flag to false, so the same IDBRequest delivers the
+        // next record; a cursor reuses its request rather than making a new one.
+        let request = self.request.get().ok_or(Error::InvalidState(None))?;
+        request.set_ready_state_pending();
+
+        let store = self.effective_object_store();
+        let range = self.range.clone();
+        let iteration_param = IterationParam {
+            cursor: Trusted::new(self),
+            key,
+            primary_key,
+            count,
+        };
+
+        // Step: Run the steps to asynchronously execute a request with the cursor's
+        // source as source, the steps to iterate a cursor as operation, and request.
+        IDBRequest::execute_async(
+            cx,
+            &store,
+            |callback| {
+                AsyncOperation::ReadOnly(AsyncReadOnlyOperation::Iterate {
+                    callback,
+                    key_range: range,
+                })
+            },
+            Some(request),
+            Some(iteration_param),
+        )?;
+        Ok(())
+    }
+
+    /// The checks every iteration method shares.
+    ///
+    /// <https://w3c.github.io/IndexedDB/#dom-idbcursor-continue> steps 1 to 4.
+    fn check_can_iterate(&self) -> Fallible<()> {
+        // Step: If this cursor's transaction is not active, throw a
+        // "TransactionInactiveError" DOMException.
+        if !self.transaction.is_active() || !self.transaction.is_usable() {
+            return Err(Error::TransactionInactive(None));
+        }
+
+        // Step: If this cursor's source or effective object store has been deleted,
+        // throw an "InvalidStateError" DOMException.
+        self.effective_object_store().verify_not_deleted()?;
+
+        // Step: If this cursor's got value flag is false, throw an
+        // "InvalidStateError" DOMException. An iteration is already in flight.
+        if !self.got_value.get() {
+            return Err(Error::InvalidState(None));
+        }
+        Ok(())
+    }
+
+    /// A key given to `continue()` must move the cursor forwards, in whichever
+    /// direction the cursor runs.
+    ///
+    /// <https://w3c.github.io/IndexedDB/#dom-idbcursor-continue> step 5.
+    fn check_key_advances(&self, key: &IndexedDBKeyType) -> Fallible<()> {
+        let position = self.position.borrow();
+        let Some(position) = position.as_ref() else {
+            return Ok(());
+        };
+        let moves_forward = match self.direction {
+            IDBCursorDirection::Next | IDBCursorDirection::Nextunique => key > position,
+            IDBCursorDirection::Prev | IDBCursorDirection::Prevunique => key < position,
+        };
+        if moves_forward {
+            Ok(())
+        } else {
+            Err(Error::Data(None))
+        }
+    }
 }
 
 impl IDBCursorMethods<crate::DomTypeHolder> for IDBCursor {
@@ -244,6 +347,65 @@ impl IDBCursorMethods<crate::DomTypeHolder> for IDBCursor {
             .get()
             .expect("IDBCursor.request should be set when cursor is opened")
     }
+
+    /// <https://w3c.github.io/IndexedDB/#dom-idbcursor-continue>
+    fn Continue(&self, cx: &mut JSContext, key: HandleValue) -> Fallible<()> {
+        self.check_can_iterate()?;
+
+        // Step 5. If key is given, convert it to a key, and require that it move
+        // the cursor in its own direction.
+        let key = if key.is_undefined() {
+            None
+        } else {
+            let key = convert_value_to_key(cx, key, None)?.into_result()?;
+            self.check_key_advances(&key)?;
+            Some(key)
+        };
+
+        self.run_iteration(cx, key, None, None)
+    }
+
+    /// <https://w3c.github.io/IndexedDB/#dom-idbcursor-continueprimarykey>
+    fn ContinuePrimaryKey(
+        &self,
+        cx: &mut JSContext,
+        key: HandleValue,
+        primary_key: HandleValue,
+    ) -> Fallible<()> {
+        // Step: If this cursor's source is not an index, throw an
+        // "InvalidAccessError" DOMException. A primary key only disambiguates
+        // records that share an index key.
+        if !matches!(self.source, ObjectStoreOrIndex::Index(_)) {
+            return Err(Error::InvalidAccess(None));
+        }
+
+        // Step: If this cursor's direction is not "next" or "prev", throw an
+        // "InvalidAccessError" DOMException.
+        if !matches!(
+            self.direction,
+            IDBCursorDirection::Next | IDBCursorDirection::Prev
+        ) {
+            return Err(Error::InvalidAccess(None));
+        }
+
+        self.check_can_iterate()?;
+
+        let key = convert_value_to_key(cx, key, None)?.into_result()?;
+        let primary_key = convert_value_to_key(cx, primary_key, None)?.into_result()?;
+
+        self.run_iteration(cx, Some(key), Some(primary_key), None)
+    }
+
+    /// <https://w3c.github.io/IndexedDB/#dom-idbcursor-advance>
+    fn Advance(&self, cx: &mut JSContext, count: u32) -> Fallible<()> {
+        // Step 1. If count is 0, throw a TypeError.
+        if count == 0 {
+            return Err(Error::Type(c"count must not be zero".to_owned()));
+        }
+
+        self.check_can_iterate()?;
+        self.run_iteration(cx, None, None, Some(count))
+    }
 }
 
