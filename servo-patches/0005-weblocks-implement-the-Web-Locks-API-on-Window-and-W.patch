+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+use dom_struct::dom_struct;
+use js::context::JSContext;
+use script_bindings::reflector::{Reflector, reflect_dom_object_with_cx};
+use script_bindings::root::DomRoot;
+
+use crate::dom::bindings::codegen::Bindings::WebLocksBinding::{LockMethods, LockMode};
+use crate::dom::bindings::str::DOMString;
+use crate::dom::globalscope::GlobalScope;
+
+/// <https://w3c.github.io/web-locks/#api-lock>
+///
+/// Handed to the callback of a granted [`LockManager::request`]. It is a receipt,
+/// not a handle: the lock is released when the callback's promise settles, so
+/// there is nothing to call on it.
+#[dom_struct]
+pub(crate) struct Lock {
+    reflector_: Reflector,
+    name: DOMString,
+    mode: LockMode,
+}
+
+impl Lock {
+    fn new_inherited(name: DOMString, mode: LockMode) -> Lock {
+        Lock {
+            reflector_: Reflector::new(),
+            name,
+            mode,
+        }
+    }
+
+    pub(crate) fn new(
+        cx: &mut JSContext,
+        global: &GlobalScope,
+        name: DOMString,
+        mode: LockMode,
+    ) -> DomRoot<Lock> {
+        reflect_dom_object_with_cx(Box::new(Lock::new_inherited(name, mode)), global, cx)
+    }
+}
+
+impl LockMethods<crate::DomTypeHolder> for Lock {
+    /// <https://w3c.github.io/web-locks/#dom-lock-name>
+    fn Name(&self) -> DOMString {
+        self.name.clone()
+    }
+
+    /// <https://w3c.github.io/web-locks/#dom-lock-mode>
+    fn Mode(&self) -> LockMode {
+        self.mode
+    }
+}
diff --git a/components/script/dom/weblocks/lockmanager.rs b/components/script/dom/weblocks/lockmanager.rs
new file mode 100644
index 000000000..f22619946
--- /dev/null
+++ b/components/script/dom/weblocks/lockmanager.rs
@@ -0,0 +1,330 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::rc::Rc;
+
+use dom_struct::dom_struct;
+use js::context::JSContext;
+use js::gc::HandleValue;
+use js::realm::CurrentRealm;
+use script_bindings::callback::{ExceptionHandling, RootedCallback, TracedCallback};
+use script_bindings::reflector::{Reflector, reflect_dom_object_with_cx};
+use script_bindings::root::DomRoot;
+
+use crate::dom::Promise;
+use crate::dom::bindings::codegen::Bindings::WebLocksBinding::{
+    LockGrantedCallback, LockInfo, LockManagerMethods, LockManagerSnapshot, LockMode, LockOptions,
+};
+use crate::dom::bindings::error::Error;
+use crate::dom::bindings::refcounted::Trusted;
+use crate::dom::bindings::reflector::DomGlobal;
+use crate::dom::bindings::str::DOMString;
+use crate::dom::globalscope::GlobalScope;
+use crate::dom::promise::promisenativehandler::{Callback, PromiseNativeHandler};
+use crate::dom::weblocks::lock::Lock;
+use crate::dom::weblocks::registry;
+use crate::realms::enter_auto_realm;
+
+/// A request that is waiting its turn. Held here, on the DOM object, so the
+/// promise and the page's callback stay traced while the lock is contended.
+#[derive(JSTraceable, MallocSizeOf)]
+#[cfg_attr(crown, crown::unrooted_must_root_lint::must_root)]
+struct PendingRequest {
+    #[conditional_malloc_size_of]
+    promise: Rc<Promise>,
+    callback: TracedCallback<LockGrantedCallback>,
+    name: DOMString,
+    mode: LockMode,
+}
+
+/// <https://w3c.github.io/web-locks/#api-lock-manager>
+///
+/// One per global. The locks themselves are process-wide and live in
+/// [`registry`], because a window and its workers share an origin and must see
+/// the same locks.
+#[dom_struct]
+pub(crate) struct LockManager {
+    reflector_: Reflector,
+    /// Names this context in the results of [`query`](LockManagerMethods::Query).
+    client_id: DOMString,
+    /// Queued requests belonging to this global, by registry id.
+    #[ignore_malloc_size_of = "small bookkeeping map"]
+    pending: RefCell<HashMap<u64, PendingRequest>>,
+}
+
+impl LockManager {
+    fn new_inherited(client_id: DOMString) -> LockManager {
+        LockManager {
+            reflector_: Reflector::new(),
+            client_id,
+            pending: RefCell::new(HashMap::new()),
+        }
+    }
+
+    pub(crate) fn new(cx: &mut JSContext, global: &GlobalScope) -> DomRoot<LockManager> {
+        // Enough to tell two contexts of one origin apart, which is all a client id
+        // is used for here.
+        let client_id = DOMString::from(format!("client-{}", registry::next_id()));
+        reflect_dom_object_with_cx(Box::new(LockManager::new_inherited(client_id)), global, cx)
+    }
+
+    fn origin(&self) -> String {
+        self.global().origin().immutable().ascii_serialization().to_string()
+    }
+
+    fn key(&self, name: &DOMString) -> registry::Key {
+        (self.origin(), name.to_string())
+    }
+
+    /// The shared body of both `request` overloads.
+    fn request_lock(
+        &self,
+        cx: &mut JSContext,
+        name: DOMString,
+        options: &LockOptions,
+        callback: RootedCallback<LockGrantedCallback>,
+    ) -> Rc<Promise> {
+        let global = self.global();
+        let promise = Promise::new(cx, &global);
+
+        // <https://w3c.github.io/web-locks/#request-method> steps 3 to 6.
+        if name.starts_with('-') {
+            promise.reject_error(
+                cx,
+                Error::NotSupported(Some("a lock name may not start with '-'".into())),
+            );
+            return promise;
+        }
+        if options.steal && options.mode == LockMode::Shared {
+            promise.reject_error(
+                cx,
+                Error::NotSupported(Some("steal requires the exclusive mode".into())),
+            );
+            return promise;
+        }
+        if options.steal && options.ifAvailable {
+            promise.reject_error(
+                cx,
+                Error::NotSupported(Some("steal and ifAvailable are mutually exclusive".into())),
+            );
+            return promise;
+        }
+
+        let id = registry::next_id();
+        let mode = options.mode;
+        let waker = {
+            let this = Trusted::new(self);
+            let task_source = global
+                .task_manager()
+                .dom_manipulation_task_source()
+                .to_sendable();
+            Box::new(move || {
+                let this = this.clone();
+                task_source.queue(task!(weblocks_lock_granted: move |cx| {
+                    this.root().deliver_pending(cx, id);
+                }));
+            })
+        };
+
+        let outcome = registry::request(
+            self.key(&name),
+            id,
+            to_registry_mode(mode),
+            self.client_id.to_string(),
+            options.steal,
+            options.ifAvailable,
+            waker,
+        );
+
+        match outcome {
+            registry::Outcome::Granted => {
+                self.deliver(cx, id, &name, mode, &callback, &promise, true);
+            },
+            // <https://w3c.github.io/web-locks/#dom-lockoptions-ifavailable>: the
+            // callback still runs, with null in place of a lock.
+            registry::Outcome::Unavailable => {
+                self.deliver(cx, id, &name, mode, &callback, &promise, false);
+            },
+            registry::Outcome::Queued => {
+                self.pending.borrow_mut().insert(
+                    id,
+                    PendingRequest {
+                        promise: promise.clone(),
+                        callback: callback.to_traced(),
+                        name,
+                        mode,
+                    },
+                );
+            },
+        }
+        promise
+    }
+
+    /// A queued request whose turn has come, woken by whoever released the lock.
+    fn deliver_pending(&self, cx: &mut JSContext, id: u64) {
+        let Some(pending) = self.pending.borrow_mut().remove(&id) else {
+            return;
+        };
+        self.deliver(
+            cx,
+            id,
+            &pending.name,
+            pending.mode,
+            &pending.callback,
+            &pending.promise,
+            true,
+        );
+    }
+
+    /// Run the page's callback and tie the lock's lifetime to the promise it
+    /// returns, which is what makes a lock release itself.
+    fn deliver(
+        &self,
+        cx: &mut JSContext,
+        id: u64,
+        name: &DOMString,
+        mode: LockMode,
+        callback: &LockGrantedCallback,
+        promise: &Rc<Promise>,
+        holds_lock: bool,
+    ) {
+        let global = self.global();
+        let lock = holds_lock.then(|| Lock::new(cx, &global, name.clone(), mode));
+
+        let result = callback.Call__(cx, lock.as_deref(), ExceptionHandling::Rethrow);
+
+        let inner = match result {
+            Ok(inner) => inner,
+            Err(error) => {
+                // The callback threw, so the lock is not held by anything now.
+                if holds_lock {
+                    registry::release(&self.key(name), id);
+                }
+                promise.reject_error(cx, error);
+                return;
+            },
+        };
+
+        let release = ReleaseTarget {
+            origin: self.origin(),
+            name: name.to_string(),
+            id,
+            active: holds_lock,
+        };
+        let handler = PromiseNativeHandler::new(
+            cx,
+            &global,
+            Some(Box::new(SettleLock {
+                promise: promise.clone(),
+                release: release.clone(),
+                rejected: false,
+            }) as Box<dyn Callback>),
+            Some(Box::new(SettleLock {
+                promise: promise.clone(),
+                release,
+                rejected: true,
+            }) as Box<dyn Callback>),
+        );
+        let mut realm = enter_auto_realm(cx, &*global);
+        inner.append_native_handler(&mut realm.current_realm(), &handler);
+    }
+}
+
+/// Which lock to let go of once the callback's promise settles.
+#[derive(Clone, JSTraceable, MallocSizeOf)]
+struct ReleaseTarget {
+    origin: String,
+    name: String,
+    id: u64,
+    /// False for an `ifAvailable` request that never got the lock.
+    active: bool,
+}
+
+impl ReleaseTarget {
+    fn release(&self) {
+        if self.active {
+            registry::release(&(self.origin.clone(), self.name.clone()), self.id);
+        }
+    }
+}
+
+/// Releases the lock, then settles the outer promise the same way the callback's
+/// promise settled. This is the whole release mechanism: a Web Lock is held for
+/// exactly as long as the promise its callback returned.
+#[derive(JSTraceable, MallocSizeOf)]
+#[cfg_attr(crown, crown::unrooted_must_root_lint::must_root)]
+struct SettleLock {
+    #[conditional_malloc_size_of]
+    promise: Rc<Promise>,
+    release: ReleaseTarget,
+    rejected: bool,
+}
+
+impl Callback for SettleLock {
+    fn callback(&self, cx: &mut CurrentRealm, value: HandleValue) {
+        self.release.release();
+        if self.rejected {
+            self.promise.reject(cx, value);
+        } else {
+            self.promise.resolve(cx, value);
+        }
+    }
+}
+
+fn to_registry_mode(mode: LockMode) -> registry::Mode {
+    match mode {
+        LockMode::Shared => registry::Mode::Shared,
+        LockMode::Exclusive => registry::Mode::Exclusive,
+    }
+}
+
+fn to_dom_mode(mode: registry::Mode) -> LockMode {
+    match mode {
+        registry::Mode::Shared => LockMode::Shared,
+        registry::Mode::Exclusive => LockMode::Exclusive,
+    }
+}
+
+impl LockManagerMethods<crate::DomTypeHolder> for LockManager {
+    /// <https://w3c.github.io/web-locks/#dom-lockmanager-request>
+    fn Request(
+        &self,
+        cx: &mut JSContext,
+        name: DOMString,
+        callback: RootedCallback<LockGrantedCallback>,
+    ) -> Rc<Promise> {
+        self.request_lock(cx, name, &LockOptions::empty(), callback)
+    }
+
+    /// <https://w3c.github.io/web-locks/#dom-lockmanager-request>
+    fn Request_(
+        &self,
+        cx: &mut JSContext,
+        name: DOMString,
+        options: &LockOptions,
+        callback: RootedCallback<LockGrantedCallback>,
+    ) -> Rc<Promise> {
+        self.request_lock(cx, name, options, callback)
+    }
+
+    /// <https://w3c.github.io/web-locks/#dom-lockmanager-query>
+    fn Query(&self, cx: &mut JSContext) -> Rc<Promise> {
+        let global = self.global();
+        let promise = Promise::new(cx, &global);
+        let (held, pending) = registry::snapshot(&self.origin());
+        let to_info = |info: registry::Info| LockInfo {
+            name: Some(DOMString::from(info.name)),
+            mode: Some(to_dom_mode(info.mode)),
+            clientId: Some(DOMString::from(info.client_id)),
+        };
+        let snapshot = LockManagerSnapshot {
+            held: Some(held.into_iter().map(to_info).collect()),
+            pending: Some(pending.into_iter().map(to_info).collect()),
+        };
+        promise.resolve_native(cx, &snapshot);
+        promise
+    }
+}
