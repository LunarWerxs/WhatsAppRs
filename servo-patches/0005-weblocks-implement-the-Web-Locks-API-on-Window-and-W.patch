diff --git a/components/script/dom/weblocks/registry.rs b/components/script/dom/weblocks/registry.rs
new file mode 100644
index 000000000..a61ac1e51
--- /dev/null
+++ b/components/script/dom/weblocks/registry.rs
@@ -0,0 +1,353 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! The lock bookkeeping behind [`LockManager`](super::lockmanager::LockManager).
+//!
+//! Web Locks are shared by every context of one origin, so this state cannot live
+//! on the DOM object: a window and its workers each get their own `LockManager`
+//! and must still see one another's locks. It is therefore process-global, keyed
+//! by origin, and guarded by a mutex because dedicated workers run on their own
+//! threads.
+//!
+//! A waiter cannot be woken directly, because the thread that releases a lock is
+//! usually not the thread that wanted it. Each waiter therefore parks a `waker`
+//! here, a small `Send` closure that queues a task back on its own event loop; the
+//! releasing thread runs it. Nothing that is not `Send` is stored.
+
+use std::collections::{HashMap, VecDeque};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{LazyLock, Mutex};
+
+/// Which contexts a lock excludes.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) enum Mode {
+    Shared,
+    Exclusive,
+}
+
+/// Origin plus lock name. Two origins may hold the same name at once.
+pub(crate) type Key = (String, String);
+
+/// Queues a granted lock back onto the requesting thread's event loop.
+type Waker = Box<dyn FnOnce() + Send>;
+
+struct Holder {
+    id: u64,
+    mode: Mode,
+    client_id: String,
+}
+
+struct Waiter {
+    id: u64,
+    mode: Mode,
+    client_id: String,
+    waker: Waker,
+}
+
+#[derive(Default)]
+struct Entry {
+    held: Vec<Holder>,
+    waiting: VecDeque<Waiter>,
+}
+
+impl Entry {
+    /// A shared request joins other shared holders; an exclusive one needs the
+    /// lock empty. A queue that is already occupied blocks newcomers, so a waiting
+    /// exclusive request is not starved by a stream of shared ones.
+    fn can_grant(&self, mode: Mode) -> bool {
+        if !self.waiting.is_empty() {
+            return false;
+        }
+        match mode {
+            Mode::Exclusive => self.held.is_empty(),
+            Mode::Shared => self.held.iter().all(|h| h.mode == Mode::Shared),
+        }
+    }
+
+    fn is_empty(&self) -> bool {
+        self.held.is_empty() && self.waiting.is_empty()
+    }
+}
+
+static REGISTRY: LazyLock<Mutex<HashMap<Key, Entry>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+
+static NEXT_ID: AtomicU64 = AtomicU64::new(1);
+
+/// A process-wide identifier for one lock request.
+pub(crate) fn next_id() -> u64 {
+    NEXT_ID.fetch_add(1, Ordering::Relaxed)
+}
+
+/// What happened to a request. `Queued` means the waker will fire later.
+#[derive(Debug, PartialEq)]
+pub(crate) enum Outcome {
+    Granted,
+    /// `ifAvailable` was set and the lock was taken.
+    Unavailable,
+    Queued,
+}
+
+/// Ask for a lock. On `Outcome::Granted` the caller owns it until it calls
+/// [`release`] with the same `id`.
+pub(crate) fn request(
+    key: Key,
+    id: u64,
+    mode: Mode,
+    client_id: String,
+    steal: bool,
+    if_available: bool,
+    waker: Waker,
+) -> Outcome {
+    let mut registry = REGISTRY.lock().unwrap();
+    let entry = registry.entry(key).or_default();
+
+    // <https://w3c.github.io/web-locks/#dom-lockoptions-steal>: the existing
+    // holders lose the lock. Their promises are left to settle on their own rather
+    // than being rejected with AbortError, which is a deviation worth knowing
+    // about; nothing in the platform can force their callbacks to stop.
+    if steal {
+        entry.held.clear();
+    }
+
+    if steal || entry.can_grant(mode) {
+        entry.held.push(Holder {
+            id,
+            mode,
+            client_id,
+        });
+        return Outcome::Granted;
+    }
+
+    // Reaching here means something is holding or waiting, so the entry is not
+    // one this call just created and there is nothing to clean up.
+    if if_available {
+        return Outcome::Unavailable;
+    }
+
+    entry.waiting.push_back(Waiter {
+        id,
+        mode,
+        client_id,
+        waker,
+    });
+    Outcome::Queued
+}
+
+/// Give up a held lock, or abandon a queued request. Any waiters that this frees
+/// are granted here and their wakers run, outside the registry lock.
+pub(crate) fn release(key: &Key, id: u64) {
+    let mut woken: Vec<Waker> = Vec::new();
+    {
+        let mut registry = REGISTRY.lock().unwrap();
+        let Some(entry) = registry.get_mut(key) else {
+            return;
+        };
+        entry.held.retain(|h| h.id != id);
+        if let Some(index) = entry.waiting.iter().position(|w| w.id == id) {
+            entry.waiting.remove(index);
+        }
+
+        // Hand the lock to whoever is next in line, and to every shared request
+        // stacked behind them.
+        while let Some(next) = entry.waiting.front() {
+            let mode = next.mode;
+            let grantable = match mode {
+                Mode::Exclusive => entry.held.is_empty(),
+                Mode::Shared => entry.held.iter().all(|h| h.mode == Mode::Shared),
+            };
+            if !grantable {
+                break;
+            }
+            let waiter = entry.waiting.pop_front().expect("front() just succeeded");
+            entry.held.push(Holder {
+                id: waiter.id,
+                mode: waiter.mode,
+                client_id: waiter.client_id,
+            });
+            woken.push(waiter.waker);
+            if mode == Mode::Exclusive {
+                break;
+            }
+        }
+
+        if entry.is_empty() {
+            registry.remove(key);
+        }
+    }
+
+    for waker in woken {
+        waker();
+    }
+}
+
+/// One row of [`snapshot`].
+pub(crate) struct Info {
+    pub(crate) name: String,
+    pub(crate) mode: Mode,
+    pub(crate) client_id: String,
+}
+
+/// Every held and pending lock for one origin.
+/// <https://w3c.github.io/web-locks/#dom-lockmanager-query>
+pub(crate) fn snapshot(origin: &str) -> (Vec<Info>, Vec<Info>) {
+    let registry = REGISTRY.lock().unwrap();
+    let mut held = Vec::new();
+    let mut pending = Vec::new();
+    for ((entry_origin, name), entry) in registry.iter() {
+        if entry_origin != origin {
+            continue;
+        }
+        for holder in &entry.held {
+            held.push(Info {
+                name: name.clone(),
+                mode: holder.mode,
+                client_id: holder.client_id.clone(),
+            });
+        }
+        for waiter in &entry.waiting {
+            pending.push(Info {
+                name: name.clone(),
+                mode: waiter.mode,
+                client_id: waiter.client_id.clone(),
+            });
+        }
+    }
+    (held, pending)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn key(name: &str) -> Key {
+        ("https://example.com".into(), name.into())
+    }
+
+    #[test]
+    fn exclusive_excludes_then_hands_over() {
+        let k = key("exclusive_excludes_then_hands_over");
+        let first = next_id();
+        assert_eq!(
+            request(
+                k.clone(),
+                first,
+                Mode::Exclusive,
+                "a".into(),
+                false,
+                false,
+                Box::new(|| {})
+            ),
+            Outcome::Granted
+        );
+
+        let second = next_id();
+        let granted = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let flag = granted.clone();
+        assert_eq!(
+            request(
+                k.clone(),
+                second,
+                Mode::Exclusive,
+                "b".into(),
+                false,
+                false,
+                Box::new(move || flag.store(true, Ordering::SeqCst))
+            ),
+            Outcome::Queued
+        );
+        assert!(!granted.load(Ordering::SeqCst));
+
+        release(&k, first);
+        assert!(granted.load(Ordering::SeqCst), "the waiter should be woken");
+        release(&k, second);
+    }
+
+    #[test]
+    fn shared_locks_share() {
+        let k = key("shared_locks_share");
+        let a = next_id();
+        let b = next_id();
+        for id in [a, b] {
+            assert_eq!(
+                request(
+                    k.clone(),
+                    id,
+                    Mode::Shared,
+                    "c".into(),
+                    false,
+                    false,
+                    Box::new(|| {})
+                ),
+                Outcome::Granted
+            );
+        }
+        release(&k, a);
+        release(&k, b);
+    }
+
+    #[test]
+    fn if_available_does_not_queue() {
+        let k = key("if_available_does_not_queue");
+        let held = next_id();
+        request(
+            k.clone(),
+            held,
+            Mode::Exclusive,
+            "d".into(),
+            false,
+            false,
+            Box::new(|| {}),
+        );
+        assert_eq!(
+            request(
+                k.clone(),
+                next_id(),
+                Mode::Exclusive,
+                "e".into(),
+                false,
+                true,
+                Box::new(|| {})
+            ),
+            Outcome::Unavailable
+        );
+        release(&k, held);
+    }
+
+    #[test]
+    fn steal_takes_it_from_the_holder() {
+        let k = key("steal_takes_it_from_the_holder");
+        let victim = next_id();
+        request(
+            k.clone(),
+            victim,
+            Mode::Exclusive,
+            "f".into(),
+            false,
+            false,
+            Box::new(|| {}),
+        );
+        let thief = next_id();
+        assert_eq!(
+            request(
+                k.clone(),
+                thief,
+                Mode::Exclusive,
+                "g".into(),
+                true,
+                false,
+                Box::new(|| {})
+            ),
+            Outcome::Granted
+        );
+        let (held, _) = snapshot("https://example.com");
+        let mine: Vec<_> = held
+            .iter()
+            .filter(|i| i.name == "steal_takes_it_from_the_holder")
+            .collect();
+        assert_eq!(mine.len(), 1, "the stolen holder should be gone");
+        assert_eq!(mine[0].client_id, "g");
+        release(&k, thief);
+    }
+}
